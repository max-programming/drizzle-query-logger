{
  "name": "drizzle-query-logger",
  "version": "1.1.2",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "release:patch": "npm version patch -m 'chore: release %s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore: release %s' && git push --follow-tags",
    "release:major": "npm version major -m 'chore: release %s' && git push --follow-tags"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.3 <1.0.0",
    "typescript": "^5 || ^6 || ^7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/max-programming/drizzle-query-logger"
  },
  "homepage": "https://github.com/max-programming/drizzle-query-logger#readme",
  "bugs": {
    "url": "https://github.com/max-programming/drizzle-query-logger/issues"
  },
  "keywords": [
    "drizzle",
    "orm",
    "logger",
    "query",
    "logging"
  ],
  "license": "MIT",
  "dependencies": {
    "@sqltools/formatter": "^1.2.5"
  }
}
